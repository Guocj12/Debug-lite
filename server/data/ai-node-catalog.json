{
  "_comment": "积木节点目录（单一数据源，D-178）。玩家层词汇表：**只有原语，没有打包好的战术宏**（战术由原语组合而成）。每个节点有且只有一个固定品质（品质=功能阶梯，不随掉落掷骰）：common 绿 / rare 蓝 / epic 紫 / legendary 橙 / mythic 青。编译规则 id → server/ai/blueprint.js 的 RULES（代码只解释规则，不写死节点清单）。",
  "_contract": "docs/systems/12-ai-nodes.md；docs/interfaces.md §1 server/ai/blueprint.js",
  "version": 1,
  "_kinds": {
    "stmt": "语句节点（占一个行动位置，可带分支/循环）",
    "bool": "布尔表达式节点（条件位置）",
    "value": "数值/文本表达式节点（取值位置）"
  },
  "_inputs": "inputs.min/max = 子节点个数区间（max = -1 表示不限）；inputs.kinds = 每个位置期望的子节点类别（末项重复适用；max=-1 时末项适用于其余全部）",
  "_scanSlots": { "effects": 4, "skills": 3 },
  "nodes": [
    { "id": "f_seq", "name": "按顺序", "quality": "common", "category": "流程", "kind": "stmt",
      "compile": "seq", "inputs": { "min": 0, "max": -1, "kinds": ["stmt"] },
      "desc": "从上到下依次执行；遇到产生行动的子节点就停在本帧，下一帧继续" },

    { "id": "f_if", "name": "如果…否则", "quality": "common", "category": "流程", "kind": "stmt",
      "compile": "if", "inputs": { "min": 2, "max": 3, "kinds": ["bool", "stmt", "stmt"] },
      "desc": "条件成立走第一个分支，否则走第二个；不写否则 = 什么都不做（等待）" },

    { "id": "a_advance", "name": "推进（朝对手）", "quality": "common", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "move_right",
      "desc": "朝对手方向移动 1 格（AI 世界里对手永远在自己的右侧）" },
    { "id": "a_retreat", "name": "后撤（远离对手）", "quality": "common", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "move_left",
      "desc": "远离对手方向移动 1 格" },
    { "id": "a_dodge_back", "name": "闪避（远离对手）", "quality": "common", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "dodge_left",
      "desc": "远离对手方向闪避 2 格，可穿过对手，本帧闪避率提高" },
    { "id": "a_defend", "name": "防御", "quality": "common", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "defend",
      "desc": "本帧防御力提高（受到的伤害降低）" },
    { "id": "a_wait", "name": "等待", "quality": "common", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "wait",
      "desc": "本帧什么都不做" },
    { "id": "a_skill", "name": "释放技能", "quality": "common", "category": "动作", "kind": "stmt",
      "compile": "action_skill", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "slot", "label": "技能槽", "type": "slot", "values": [1, 2, 3], "default": 1 }],
      "desc": "释放指定技能槽的技能；冷却中或资源不足时该行动作废（不会自动改放别的）" },

    { "id": "v_number", "name": "数字", "quality": "common", "category": "取值", "kind": "value",
      "compile": "number", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "value", "label": "数值", "type": "num", "min": -1000, "max": 1000, "default": 1 }],
      "desc": "一个固定数值（配合『比较』『计算』使用；血量/距离等比例是 0~1 的小数，距离差可以为负）" },

    { "id": "s_my_hp", "name": "我的血量", "quality": "common", "category": "感知", "kind": "value",
      "compile": "get", "inputs": { "min": 0, "max": 0, "kinds": [] }, "path": "self.hp",
      "desc": "当前血量绝对值（要按比例判断请用『我的血量%』）" },
    { "id": "s_my_hp_pct", "name": "我的血量%", "quality": "common", "category": "感知", "kind": "value",
      "compile": "pct", "inputs": { "min": 0, "max": 0, "kinds": [] }, "ref": { "num": "self.hp", "den": "self.maxHp" },
      "desc": "当前血量 ÷ 血量上限（0~1）" },
    { "id": "s_my_mp_pct", "name": "我的法力%", "quality": "common", "category": "感知", "kind": "value",
      "compile": "pct", "inputs": { "min": 0, "max": 0, "kinds": [] }, "ref": { "num": "self.mp", "den": "self.maxMp" },
      "desc": "当前法力 ÷ 法力上限（0~1）" },
    { "id": "s_my_sp", "name": "我的体力", "quality": "common", "category": "感知", "kind": "value",
      "compile": "get", "inputs": { "min": 0, "max": 0, "kinds": [] }, "path": "self.sp",
      "desc": "当前体力值" },
    { "id": "s_my_cd", "name": "我的技能冷却", "quality": "common", "category": "感知", "kind": "value",
      "compile": "slot_path", "inputs": { "min": 0, "max": 0, "kinds": [] }, "pathTemplate": "self.cooldowns.skill{slot}",
      "params": [{ "key": "slot", "label": "技能槽", "type": "slot", "values": [1, 2, 3], "default": 1 }],
      "desc": "指定技能槽还剩几帧冷却（0 = 可以放）" },
    { "id": "s_tick", "name": "当前帧数", "quality": "common", "category": "感知", "kind": "value",
      "compile": "get", "inputs": { "min": 0, "max": 0, "kinds": [] }, "path": "tick",
      "desc": "本场战斗已经进行的帧数" },
    { "id": "s_gap", "name": "与对手的距离", "quality": "common", "category": "感知", "kind": "value",
      "compile": "arith_paths", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "ref": { "op": "-", "left": "enemy.x", "right": "self.x" },
      "desc": "对手格序号 − 我方格序号（格数；对手永远在自己的右侧）" },
    { "id": "s_foe_hp_pct", "name": "对手血量%", "quality": "common", "category": "感知", "kind": "value",
      "compile": "pct", "inputs": { "min": 0, "max": 0, "kinds": [] }, "ref": { "num": "enemy.hp", "den": "enemy.maxHp" },
      "desc": "对手当前血量 ÷ 对手血量上限（0~1）" },

    { "id": "c_hp_below", "name": "我的血量低于X%", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "pct_below", "inputs": { "min": 0, "max": 0, "kinds": [] }, "ref": { "num": "self.hp", "den": "self.maxHp" },
      "params": [{ "key": "x", "label": "百分比", "type": "pct", "min": 1, "max": 100, "default": 30 }],
      "desc": "血量百分比低于给定值" },
    { "id": "c_gap_less", "name": "距离小于X格", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "gap_cmp", "inputs": { "min": 0, "max": 0, "kinds": [] }, "op": "<",
      "params": [{ "key": "x", "label": "格数", "type": "num", "min": 0, "max": 15, "default": 2 }],
      "desc": "与对手的格数差小于给定值（可用小数，如 2.5 即「3 格及以上不成立」）" },
    { "id": "c_gap_greater", "name": "距离大于X格", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "gap_cmp", "inputs": { "min": 0, "max": 0, "kinds": [] }, "op": ">",
      "params": [{ "key": "x", "label": "格数", "type": "num", "min": 0, "max": 15, "default": 3 }],
      "desc": "与对手的格数差大于给定值（可用小数）" },
    { "id": "c_skill_ready", "name": "技能N已就绪", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "slot_ready", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "slot", "label": "技能槽", "type": "slot", "values": [1, 2, 3], "default": 1 }],
      "desc": "指定技能槽不在冷却中" },
    { "id": "c_random", "name": "随机X%", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "random", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "x", "label": "百分比", "type": "pct", "min": 1, "max": 100, "default": 50 }],
      "desc": "以给定概率成立（每次判定消耗一次随机）" },
    { "id": "c_and", "name": "且", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "logic", "inputs": { "min": 2, "max": 2, "kinds": ["bool"] }, "op": "and",
      "desc": "两个条件都成立" },
    { "id": "c_or", "name": "或", "quality": "common", "category": "条件", "kind": "bool",
      "compile": "logic", "inputs": { "min": 2, "max": 2, "kinds": ["bool"] }, "op": "or",
      "desc": "两个条件任一成立" },

    { "id": "c_not", "name": "非", "quality": "rare", "category": "条件", "kind": "bool",
      "compile": "not", "inputs": { "min": 1, "max": 1, "kinds": ["bool"] },
      "desc": "条件不成立（编译期做德摩根展开）" },
    { "id": "c_gap_between", "name": "距离在X~Y格", "quality": "rare", "category": "条件", "kind": "bool",
      "compile": "gap_between", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [
        { "key": "x", "label": "最小格数", "type": "num", "min": 0, "max": 15, "default": 2 },
        { "key": "y", "label": "最大格数", "type": "num", "min": 0, "max": 15, "default": 4 }
      ],
      "desc": "与对手的格数差落在闭区间内" },
    { "id": "c_tick_after", "name": "第X帧之后", "quality": "rare", "category": "条件", "kind": "bool",
      "compile": "tick_after", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "x", "label": "帧数", "type": "int", "min": 0, "max": 64, "default": 10 }],
      "desc": "当前帧数超过给定值" },
    { "id": "c_compare", "name": "比较", "quality": "rare", "category": "条件", "kind": "bool",
      "compile": "compare", "inputs": { "min": 2, "max": 2, "kinds": ["value"] },
      "params": [{ "key": "op", "label": "比较", "type": "enum", "values": [">", "<", ">=", "<=", "==", "!="], "default": "<" }],
      "desc": "对两个数值做比较（配合记忆节点使用）" },
    { "id": "v_arith", "name": "计算", "quality": "rare", "category": "取值", "kind": "value",
      "compile": "arith", "inputs": { "min": 2, "max": 2, "kinds": ["value"] },
      "params": [{ "key": "op", "label": "运算", "type": "enum", "values": ["+", "-", "*", "/"], "default": "+" }],
      "desc": "两个数值做四则运算（除法向下取整）" },
    { "id": "s_foe_sp", "name": "对手体力", "quality": "rare", "category": "感知", "kind": "value",
      "compile": "get", "inputs": { "min": 0, "max": 0, "kinds": [] }, "path": "enemy.sp",
      "desc": "对手当前体力值" },
    { "id": "s_foe_cd", "name": "对手技能冷却", "quality": "rare", "category": "感知", "kind": "value",
      "compile": "slot_path", "inputs": { "min": 0, "max": 0, "kinds": [] }, "pathTemplate": "enemy.cooldowns.skill{slot}",
      "params": [{ "key": "slot", "label": "技能槽", "type": "slot", "values": [1, 2, 3], "default": 1 }],
      "desc": "对手指定技能槽还剩几帧冷却" },
    { "id": "s_my_atk", "name": "我的攻击力", "quality": "rare", "category": "感知", "kind": "value",
      "compile": "get", "inputs": { "min": 0, "max": 0, "kinds": [] }, "path": "self.atk",
      "desc": "我方当前攻击力（含增益）" },
    { "id": "s_my_def", "name": "我的防御力", "quality": "rare", "category": "感知", "kind": "value",
      "compile": "get", "inputs": { "min": 0, "max": 0, "kinds": [] }, "path": "self.def",
      "desc": "我方当前防御力（含增益）" },
    { "id": "s_base_hp_pct", "name": "基地血量%", "quality": "rare", "category": "感知", "kind": "value",
      "compile": "base_pct", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "side", "label": "哪一方", "type": "enum", "values": ["self", "enemy"], "default": "self" }],
      "desc": "我方或敌方基地血量 ÷ 上限（0~1）" },

    { "id": "f_loop_n", "name": "重复N次", "quality": "epic", "category": "流程", "kind": "stmt",
      "compile": "loop_count", "inputs": { "min": 1, "max": 1, "kinds": ["stmt"] },
      "params": [{ "key": "n", "label": "次数", "type": "int", "min": 1, "max": 32, "default": 3 }],
      "desc": "把子节点连续执行给定次数（同一帧内；产生行动时才停）" },
    { "id": "f_loop_until", "name": "重复直到…", "quality": "epic", "category": "流程", "kind": "stmt",
      "compile": "loop_until", "inputs": { "min": 2, "max": 2, "kinds": ["bool", "stmt"] },
      "desc": "条件不成立就反复执行子节点" },
    { "id": "f_forever", "name": "一直重复", "quality": "epic", "category": "流程", "kind": "stmt",
      "compile": "loop_forever", "inputs": { "min": 1, "max": 1, "kinds": ["stmt"] },
      "desc": "无条件反复执行子节点（通常配合打断使用）" },
    { "id": "f_break", "name": "打断", "quality": "epic", "category": "流程", "kind": "stmt",
      "compile": "break", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "desc": "跳出当前循环（必须在循环体内）" },
    { "id": "a_move_left", "name": "向左移动", "quality": "epic", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "move_left",
      "desc": "绝对方向：向左移动（多数场合用『后撤』更直观）" },
    { "id": "a_move_right", "name": "向右移动", "quality": "epic", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "move_right",
      "desc": "绝对方向：向右移动" },
    { "id": "a_dodge_front", "name": "闪避（朝对手）", "quality": "epic", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "dodge_right",
      "desc": "朝对手方向闪避 2 格，可穿过对手" },
    { "id": "a_turn", "name": "转身", "quality": "epic", "category": "动作", "kind": "stmt",
      "compile": "action", "inputs": { "min": 0, "max": 0, "kinds": [] }, "action": "turn",
      "desc": "只改变朝向，不移动（影响背击与位移技能方向）" },

    { "id": "m_remember", "name": "记住", "quality": "legendary", "category": "记忆", "kind": "stmt",
      "compile": "mem_remember", "inputs": { "min": 1, "max": 1, "kinds": ["value"] },
      "desc": "把一个数值存进记忆（跨帧保留），用『读取记忆』取回" },
    { "id": "m_counter", "name": "计数+1", "quality": "legendary", "category": "记忆", "kind": "stmt",
      "compile": "mem_counter", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "desc": "自己的计数加一（跨帧保留），用『读取记忆』取回" },
    { "id": "m_timer", "name": "计时器N帧", "quality": "legendary", "category": "记忆", "kind": "stmt",
      "compile": "mem_timer", "inputs": { "min": 1, "max": 1, "kinds": ["stmt"] },
      "params": [{ "key": "n", "label": "帧数", "type": "int", "min": 1, "max": 32, "default": 4 }],
      "desc": "每过 N 帧执行一次子节点，其余帧等待" },
    { "id": "m_read", "name": "读取记忆", "quality": "legendary", "category": "记忆", "kind": "value",
      "compile": "mem_read", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "target", "label": "哪个记忆", "type": "uid", "default": "" }],
      "desc": "取回『记住』或『计数+1』存下的值（未存过 = 0）" },
    { "id": "s_my_skill_range", "name": "我的技能射程", "quality": "legendary", "category": "感知", "kind": "value",
      "compile": "skill_field", "inputs": { "min": 0, "max": 0, "kinds": [] }, "field": "range",
      "params": [{ "key": "slot", "label": "技能槽", "type": "slot", "values": [1, 2, 3], "default": 1 }],
      "desc": "指定技能槽的射程（格）" },
    { "id": "s_my_skill_type", "name": "我的技能类型", "quality": "legendary", "category": "感知", "kind": "value",
      "compile": "skill_field", "inputs": { "min": 0, "max": 0, "kinds": [] }, "field": "type",
      "params": [{ "key": "slot", "label": "技能槽", "type": "slot", "values": [1, 2, 3], "default": 1 }],
      "desc": "指定技能槽的类型（melee/straight/vertical/displacement）" },

    { "id": "r_sub", "name": "子程序", "quality": "mythic", "category": "结构", "kind": "stmt",
      "compile": "sub_def", "inputs": { "min": 1, "max": 1, "kinds": ["stmt"] },
      "params": [{ "key": "label", "label": "名字", "type": "text", "default": "我的套路" }],
      "desc": "打包一段逻辑，供『调用子程序』反复使用" },
    { "id": "r_call", "name": "调用子程序", "quality": "mythic", "category": "结构", "kind": "stmt",
      "compile": "sub_call", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "params": [{ "key": "target", "label": "哪个子程序", "type": "uid", "default": "" }],
      "desc": "执行指定的子程序" },
    { "id": "c_foe_stunned", "name": "对手被控制", "quality": "mythic", "category": "条件", "kind": "bool",
      "compile": "effect_any", "inputs": { "min": 0, "max": 0, "kinds": [] }, "on": "enemy", "field": "kind", "equals": "control",
      "desc": "对手身上带有控制类效果（眩晕/击退/拉拽）" },
    { "id": "c_has_effect", "name": "我身上有效果", "quality": "mythic", "category": "条件", "kind": "bool",
      "compile": "effect_any", "inputs": { "min": 0, "max": 0, "kinds": [] }, "on": "self", "field": "uid", "equals": null,
      "desc": "自己身上挂着任何持续效果（增益或减益）" },
    { "id": "s_effect_left", "name": "我的效果剩余帧", "quality": "mythic", "category": "感知", "kind": "value",
      "compile": "effect_field", "inputs": { "min": 0, "max": 0, "kinds": [] }, "on": "self", "field": "remaining",
      "params": [{ "key": "index", "label": "第几个效果", "type": "int", "min": 0, "max": 3, "default": 0 }],
      "desc": "自己第 N 个持续效果还剩几帧" },
    { "id": "c_any_skill_ready", "name": "有技能就绪", "quality": "mythic", "category": "条件", "kind": "bool",
      "compile": "any_skill_ready", "inputs": { "min": 0, "max": 0, "kinds": [] },
      "desc": "三个技能槽里至少有一个不在冷却中" }
  ]
}
